{
  "name": "wellcome",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "cd backend && npm run start",
    "expo:start": "expo start",
    "build": "cd backend && npm install && npm run build",
    "typecheck": "tsc --noEmit",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "test": "jest --runInBand",
    "lint": "expo lint",
    "dev": "concurrently -n \"FRONT,BACK\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run expo:start -- --dev-client\" \"cd backend && npm run dev\""
  },
  "dependencies": {
    "@gluestack-ui/core": "^3.0.10",
    "@gluestack-ui/utils": "^3.0.11",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-query": "^5.90.19",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~57.0.19",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "iconsax-react-nativejs": "^0.0.8",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-aria": "3.41.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-stately": "^3.39.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^0.1.20",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "autoprefixer": "^10.4.24",
    "babel-preset-expo": "~57.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "postcss": "^8.5.6",
    "supabase": "^2.91.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backend/"
    ]
  },
  "private": true
}
