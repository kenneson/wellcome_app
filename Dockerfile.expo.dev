FROM node:20-bullseye
WORKDIR /app
ENV CI=1
ENV EXPO_NO_TELEMETRY=1

COPY package*.json ./
RUN npm ci
COPY . .

EXPOSE 8081

# REACT_NATIVE_PACKAGER_HOSTNAME (definido no EasyPanel) faz o Metro anunciar
# o host publico no manifesto. Sem ele o Expo Go recebe o IP interno do container.
# O projeto tem owner/projectId do EAS, entao expo start precisa autenticar.
# Num container sem tty isso trava (Input is required). Defina EXPO_TOKEN no
# EasyPanel (expo.dev -> Account settings -> Access tokens) e ele autentica em CI.
CMD ["npx", "expo", "start", "--go", "--port", "8081"]
