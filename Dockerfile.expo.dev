FROM node:20-bullseye
WORKDIR /app
ENV CI=1
ENV EXPO_NO_TELEMETRY=1

COPY package*.json ./
RUN npm ci
COPY . .

EXPOSE 8081

# REACT_NATIVE_PACKAGER_HOSTNAME (definido no EasyPanel) faz o Metro anunciar
# o host publico no manifesto. Sem ele o Expo Go recebe o IP interno do container.
CMD ["npx", "expo", "start", "--go", "--port", "8081"]
