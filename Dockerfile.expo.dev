FROM node:20-bullseye
WORKDIR /app
ENV CI=1
ENV EXPO_NO_TELEMETRY=1

COPY package*.json ./
RUN npm ci
COPY . .

EXPOSE 8081

# REACT_NATIVE_PACKAGER_HOSTNAME (definido no EasyPanel) faz o Metro anunciar
# o host publico no manifesto. Sem ele o Expo Go recebe o IP interno do container.
# --offline: o projeto tem owner/projectId do EAS; sem isso o expo start tenta
# autenticar na conta, pede input num container sem tty, e entra em loop de restart.
CMD ["npx", "expo", "start", "--go", "--offline", "--port", "8081"]
