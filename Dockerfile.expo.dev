FROM node:20-bullseye
WORKDIR /app
ENV CI=1
ENV EXPO_NO_TELEMETRY=1

COPY package*.json ./
RUN npm ci --legacy-peer-deps \
    && rm -rf node_modules/@shopify/react-native-skia/libs/macos \
    && npm cache clean --force
COPY . .

EXPOSE 8081

# REACT_NATIVE_PACKAGER_HOSTNAME (definido no EasyPanel) faz o Metro anunciar
# o host publico no manifesto. Sem ele o Expo Go recebe o IP interno do container.
# O projeto tem owner/projectId do EAS, entao expo start precisa autenticar.
# Monte o token como um arquivo do EasyPanel em /run/secrets/expo_token. Variaveis
# do servico sao enviadas ao docker build como argumentos e podem vazar nos logs.
# --clear: EXPO_PUBLIC_* sao inlined em tempo de transform e cacheados. Sem limpar
# o cache, mudar EXPO_PUBLIC_API_URL nao surte efeito (Metro reusa o transform velho).
CMD ["sh", "-c", "if [ -f /run/secrets/expo_token ]; then export EXPO_TOKEN=$(cat /run/secrets/expo_token); fi; exec npx expo start --go --clear --port 8081"]
