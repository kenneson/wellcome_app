generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  updatedAt           DateTime?      @updatedAt @map("updated_at") @db.Timestamptz(6)
  fullName            String?        @map("full_name")
  username            String?        @unique
  avatarUrl           String?        @map("avatar_url")
  website             String?
  occupation          String?
  bio                 String?
  dietaryRestrictions String[]       @default([]) @map("dietary_restrictions")
  lookingFor          String?        @map("looking_for")
  city                String?
  neighborhood        String?
  languages           String[]       @default([])
  expoPushToken       String?        @map("expo_push_token")
  email               String?
  birthDecade         String?        @map("birth_decade")
  pets                String?
  isSuperhost         Boolean        @default(false) @map("is_superhost")
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  bookings            Booking[]
  events              Event[]
  notifications       Notification[]
  pushTokens          PushToken[]
  eventReviews        EventReview[]

  @@map("profiles")
  @@schema("public")
}

model Event {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  hostId                String          @map("host_id") @db.Uuid
  title                 String
  description           String?
  eventDate             DateTime        @map("event_date") @db.Timestamptz(6)
  endTime               DateTime?       @map("end_time") @db.Timestamptz(6)
  reservationDeadline   DateTime?       @map("reservation_deadline") @db.Timestamptz(6)
  location              String
  maxGuests             Int?            @default(0) @map("max_guests")
  coverImageUrl         String?         @map("cover_image_url")
  imageGallery          String[]        @default([]) @map("image_gallery")
  latitude              Float?
  longitude             Float?
  price                 Decimal?        @default(0) @db.Decimal
  eventType             String?         @map("event_type")
  cuisineTypes          String[]        @default([]) @map("cuisine_types")
  vibe                  String[]        @default([])
  facilities            String[]        @default([])
  rules                 String[]        @default([])
  dietaryOptions        String[]        @default([]) @map("dietary_options")
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)
  accessType            EventAccessType @default(OPEN) @map("access_type")
  requiresApproval      Boolean         @default(false) @map("requires_approval")
  allowWaitlist         Boolean         @default(false) @map("allow_waitlist")
  autoApproveIfAttended Boolean         @default(false) @map("auto_approve_if_attended")
  autoApproveMinRating  Decimal?        @map("auto_approve_min_rating") @db.Decimal(2, 1)
  bookings              Booking[]
  questions             EventQuestion[]
  dishes                EventDish[]
  reviews               EventReview[]
  host                  User            @relation(fields: [hostId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("events")
  @@schema("public")
}

model Booking {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime             @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  eventId         String               @map("event_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  status          RegistrationStatus   @default(PENDING)
  reviewedAt      DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      String?              @map("reviewed_by") @db.Uuid
  rejectionReason String?              @map("rejection_reason")
  attendedBefore  Boolean              @default(false) @map("attended_before")
  noShowCount     Int                  @default(0) @map("no_show_count")
  event           Event                @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_participants_event_fkey")
  guest           User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_participants_user_fkey")
  answers         RegistrationAnswer[]
  notes           RegistrationNote[]

  @@unique([eventId, userId], map: "event_participants_unique")
  @@map("event_participants")
  @@schema("public")
}

model EventQuestion {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String               @map("event_id") @db.Uuid
  question     String
  questionType QuestionType         @map("question_type")
  options      String[]             @default([])
  required     Boolean              @default(false)
  order        Int                  @default(0)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers      RegistrationAnswer[]

  @@index([eventId], map: "idx_event_questions_event")
  @@map("event_questions")
  @@schema("public")
}

model RegistrationAnswer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String        @map("registration_id") @db.Uuid
  questionId     String        @map("question_id") @db.Uuid
  answer         String
  question       EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "registration_answers_question_fkey")
  registration   Booking       @relation(fields: [registrationId], references: [id], onDelete: Cascade, map: "registration_answers_registration_fkey")

  @@unique([registrationId, questionId], map: "registration_answers_unique")
  @@index([registrationId], map: "idx_registration_answers_reg")
  @@map("registration_answers")
  @@schema("public")
}

model RegistrationNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  note           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid
  registration   Booking  @relation(fields: [registrationId], references: [id], onDelete: Cascade, map: "registration_notes_registration_fkey")

  @@index([registrationId], map: "idx_registration_notes_reg")
  @@map("registration_notes")
  @@schema("public")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "notifications_user_fkey")

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
  @@schema("public")
}

model PushToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique
  platform   String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "push_tokens_user_fkey")

  @@index([userId], map: "idx_push_tokens_user")
  @@map("push_tokens")
  @@schema("public")
}

model EventDish {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  name        String
  description String?
  category    String  // ENTRADA, PRATO_PRINCIPAL, SOBREMESA, BEBIDA
  order       Int     @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "idx_event_dishes_event")
  @@map("event_dishes")
  @@schema("public")
}

model EventReview {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], map: "event_reviews_unique")
  @@index([eventId], map: "idx_event_reviews_event")
  @@map("event_reviews")
  @@schema("public")
}

